{
  "ruleset_version": "saarthi.rules.v1",
  "language": "or",
  "bkt": {
    "priors": {
      "default_prior": 0.4,
      "default_learn": 0.3,
      "default_slip": 0.1,
      "default_guess": 0.25
    },
    "per_concept_overrides": {},
    "evidence_rules": {
      "mcq_correct": { "evidence": "correct", "weight": 1.0 },
      "mcq_incorrect": { "evidence": "incorrect", "weight": 1.0 },
      "short_answer_correct": { "evidence": "correct", "weight": 1.0 },
      "short_answer_partial": { "evidence": "incorrect", "weight": 0.5 },
      "short_answer_incorrect": { "evidence": "incorrect", "weight": 1.0 },
      "doubt_asked": { "evidence": null, "weight": 0.0 },
      "content_viewed": { "evidence": null, "weight": 0.0 },
      "lesson_completed": { "evidence": null, "weight": 0.0 }
    },
    "update_bounds": {
      "min_p": 0.01,
      "max_p": 0.99
    },
    "default_q_matrix": {}
  },
  "mastery": {
    "thresholds": {
      "unstarted_lo": 0.05,
      "novice_hi": 0.4,
      "developing_hi": 0.7,
      "proficient_hi": 0.9
    },
    "bands": ["unstarted", "novice", "developing", "proficient", "mastered"]
  },
  "actions": {
    "remediate_threshold": 0.4,
    "retry_threshold": 0.55,
    "revise_threshold": 0.7,
    "advance_threshold": 0.85
  },
  "repetition_guard": {
    "max_consecutive_same_action": 3,
    "max_consecutive_same_concept": 3,
    "escape_action": "REVISE"
  },
  "target_selection": {
    "strategy": "first_unmastered_then_lowest_mastery",
    "prerequisite_required": true,
    "tiebreak": "concept_id_asc"
  },
  "network": {
    "online_rt_threshold_ms": 600,
    "online_loss_threshold": 0.0,
    "weak_rt_threshold_ms": 1500,
    "weak_loss_threshold": 0.25,
    "offline_probe_timeout_ms": 800,
    "hysteresis_observations": 3,
    "online_to_weak_after_n_bad": 2,
    "weak_to_offline_after_n_bad": 2,
    "weak_to_online_after_n_good": 3,
    "offline_to_weak_after_n_good": 2
  },
  "delivery": {
    "online": "rich",
    "weak": "prefetch_then_offline",
    "offline": "cached",
    "reconnected": "rich"
  },
  "background_actions": {
    "online_after_offline": ["SYNC", "PREFETCH"],
    "weak": ["PREFETCH"],
    "offline": []
  },
  "retries": {
    "default_max_attempts": 3,
    "default_timeout_ms": 8000,
    "backoff_initial_ms": 500,
    "backoff_max_ms": 8000,
    "backoff_jitter": 0.25
  },
  "sync": {
    "batch_size": 100,
    "max_inflight_batches": 1,
    "dead_letter_after_retries": 5
  },
  "pack": {
    "max_bytes": 5242880,
    "min_app_version": "0.1.0",
    "checksum_algorithm": "sha256",
    "stale_after_days": 180
  },
  "prefetch": {
    "enabled": true,
    "wifi_only": false,
    "min_free_storage_bytes": 10485760,
    "battery_saver_skip": true,
    "max_concurrent": 1
  },
  "orchestration": {
    "max_tool_calls_per_turn": 3,
    "max_total_time_ms": 12000,
    "max_retries_per_tool": 1,
    "allowed_tools": [
      "translate_text",
      "retrieve_chunks",
      "generate_answer",
      "validate_answer"
    ]
  },
  "translation": {
    "default_provider": "mock",
    "max_input_chars": 500,
    "cache_max_entries": 1024,
    "cache_ttl_seconds": 86400,
    "min_confidence": 0.5
  },
  "retrieval": {
    "default_provider": "local_hybrid",
    "top_k": 5,
    "min_score": 0.05,
    "glossary_expansion": true
  },
  "generation": {
    "default_provider": "mock",
    "max_answer_chars": 1200,
    "require_citation": true
  },
  "validation": {
    "min_odia_unicode_ratio": 0.6,
    "max_keyword_overlap_to_claim_grounding": 0.85,
    "safety_blocked_terms": []
  }
}
