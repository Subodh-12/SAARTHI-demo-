# SAARTHI .env.example — copy to .env and adjust as needed.
# Never commit your real .env. The defaults here are no-secret local-dev values.

# ---- App ----
APP_NAME=SAARTHI
APP_VERSION=0.1.0
ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- Network ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Persistence (default: SQLite file, no extra service required) ----
PERSISTENCE_BACKEND=sqlite
DATABASE_URL=sqlite+aiosqlite:///./saarthi.db
# For PostgreSQL:
# PERSISTENCE_BACKEND=postgres
# DATABASE_URL=postgresql+asyncpg://saarthi:saarthi@localhost:5432/saarthi
DB_POOL_SIZE=5
DB_ECHO=false

# ---- Object storage (default: local filesystem) ----
OBJECT_STORAGE_BACKEND=local
PACKS_DIR=packs

# ---- Ruleset ----
SAARTHI_RULESET_PATH=packages/ruleset/rules.json

# ---- Translation (default: mock — returns typed unavailable error) ----
# To use HuggingFace IndicTrans2:
#   1. Accept gated repo conditions on:
#      https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
#      https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
#   2. Set TRANSLATION_PROVIDER=hf_local
#   3. Set HF_TOKEN (get from https://huggingface.co/settings/tokens)
TRANSLATION_PROVIDER=mock
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
HF_TRANSLATION_MODEL_EN2INDIC=ai4bharat/indictrans2-en-indic-dist-200M
HF_TRANSLATION_MODEL_INDIC2EN=ai4bharat/indictrans2-indic-en-dist-200M
TRANSLATION_CACHE_TTL_SECONDS=86400

# ---- LLM generation (default: mock — returns extractive fallback) ----
# To use OpenAI-compatible chat completion:
#   1. Set LLM_PROVIDER=openai
#   2. Set LLM_API_KEY=sk-...
#   3. Adjust LLM_MODEL and optionally LLM_BASE_URL (for compatible endpoints)
LLM_PROVIDER=mock
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=12

# ---- Retrieval / embeddings (default: local_hybrid + mock embeddings) ----
RETRIEVAL_PROVIDER=local_hybrid
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Auth ----
DEVICE_TOKEN_BYTES=32
TOKEN_TTL_SECONDS=7776000
PIN_HASH_ITERATIONS=100000

# ---- Rate limits / security ----
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=262144
ENABLE_SECURE_COOKIES=false

# ---- Feature flags ----
ENABLE_PREFETCH=true
ENABLE_VOICE_ASR=false
ENABLE_VOICE_TTS=false
ENABLE_DEV_TRACE=true

# ---- Determinism / tests ----
RANDOM_SEED=42

# ---- Frontend (Vite reads VITE_*) ----
VITE_API_URL=http://127.0.0.1:8000
